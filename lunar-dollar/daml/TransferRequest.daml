module TransferRequest where

import DA.Assert ((===))
import DA.Optional (fromOptional)

import Daml.Finance.Interface.Holding.V4.Holding qualified as Holding (I)
import Daml.Finance.Interface.Holding.V4.Util (getAmount, getInstrument)
import Daml.Finance.Interface.Types.Common.V3.Types (AccountKey(..), InstrumentKey(..))

import Compliance.Registry (ComplianceRegistry, ValidateTransfer(..))
import Holding.Transfer (splitAndTransfer)

template TransferRequest
  with
    receiverAccount : AccountKey
    instrument : InstrumentKey
    amount : Decimal
    currentOwner : Party
  where
    signatory receiverAccount.owner
    observer currentOwner, instrument.issuer

    ensure amount > 0.0

    choice Accept : ContractId Holding.I
      with
        holdingCid : ContractId Holding.I
      controller currentOwner, instrument.issuer
      do
        (registryCid, _) <- fetchByKey @ComplianceRegistry instrument.issuer
        
        results <- exercise registryCid ValidateTransfer with
          sender = currentOwner
          receiver = receiverAccount.owner
          amount
          instrument
        let rejections = filter (\r -> not r.approved) results
        let rejectionReasons = map (\r -> fromOptional "Unknown reason" r.reason) rejections
        assertMsg ("Transfer rejected by compliance: " <> show rejectionReasons) 
          (null rejections)
        
        holding <- fetch holdingCid
        let holdingAmount = getAmount holding
        assert(holdingAmount >= amount)
        getInstrument holding === instrument

        splitAndTransfer [currentOwner, receiverAccount.owner] receiverAccount amount holdingCid

    choice Decline : ()
      controller currentOwner
      do
        pure ()

    choice Withdraw : ()
      controller receiverAccount.owner
      do
        pure ()
