module Tests.X402Test where

import Daml.Script
import DA.Map qualified as Map (fromList)
import DA.Set qualified as Set

import Scripts.Setup (setup)
import Scripts.Mint (MintArgs(..), mint)
import Scripts.Balance (BalanceArgs(..), balance)
import Scripts.Util (getOrCreateParty, lookupParty)
import Scripts.X402 (SetupReceiverArgs(..), PayArgs(..), setupReceiver, pay)
import Compliance.Registry (ComplianceRegistry(..))
import Compliance.Validators.Blacklist (BlacklistValidator(..))
import Compliance.Validator (TransferValidator)

setupCompliance : Script (ContractId ComplianceRegistry)
setupCompliance = do
  bank <- lookupParty "Bank"
  
  blacklistCid <- submit bank do
    createCmd BlacklistValidator with
      operator = bank
      blacklistedParties = Set.empty
  
  let blacklistInterfaceCid = toInterfaceContractId @TransferValidator blacklistCid
  
  submit bank do
    createCmd ComplianceRegistry with
      operator = bank
      activeValidators = [blacklistInterfaceCid]

testX402PaymentFlow : Script ()
testX402PaymentFlow = do
  setup
  publicParty <- getOrCreateParty "Public"
  complianceRegistryCid <- setupCompliance

  debug "=== x402 Payment Flow Test ==="
  
  holdingCid <- mint MintArgs with
    recipient = "Alice"
    amount = 100.0

  debug "1. Alice has 100 LNRD"
  balance BalanceArgs with party = "Alice"

  receiverCid <- setupReceiver SetupReceiverArgs with
    receiver = "Bob"
    prices = Map.fromList
      [ ("/api/premium-data", 25.0)
      , ("/api/basic-data", 5.0)
      ]
    publicParty
    complianceRegistryCid

  debug "2. Bob created PaymentReceiver with price list"

  accessGrantCid <- pay PayArgs with
    payer = "Alice"
    receiver = "Bob"
    receiverCid
    sessionId = "session-abc123"
    resource = "/api/premium-data"
    maxPrice = 25.0
    holdingCid

  debug "3. Alice paid for /api/premium-data (price: 25 LNRD)"
  debug $ "   AccessGrant created: " <> show accessGrantCid

  debug "4. Final balances:"
  balance BalanceArgs with party = "Alice"
  balance BalanceArgs with party = "Bob"

  pure ()

runPayment : Script ()
runPayment = do
  alice <- lookupParty "Alice"
  complianceRegistryCid <- setupCompliance

  holdingCid <- mint MintArgs with
    recipient = "Alice"
    amount = 1000.0

  receiverCid <- setupReceiver SetupReceiverArgs with
    receiver = "Bob"
    prices = Map.fromList [("random", 250.0)]
    publicParty = alice
    complianceRegistryCid

  accessGrantCid <- pay PayArgs with
    payer = "Alice"
    receiver = "Bob"
    receiverCid
    sessionId = "session-001"
    resource = "random"
    maxPrice = 250.0
    holdingCid

  debug $ "AccessGrant created: " <> show accessGrantCid
  balance BalanceArgs with party = "Alice"
  balance BalanceArgs with party = "Bob"
  pure ()

testX402PaymentWithSplit : Script ()
testX402PaymentWithSplit = do
  setup
  publicParty <- getOrCreateParty "Public"
  complianceRegistryCid <- setupCompliance

  debug "=== x402 Payment With Split Test ==="

  holdingCid <- mint MintArgs with
    recipient = "Alice"
    amount = 100.0

  receiverCid <- setupReceiver SetupReceiverArgs with
    receiver = "Bob"
    prices = Map.fromList
      [ ("/api/expensive-resource", 25.0)
      ]
    publicParty
    complianceRegistryCid

  debug "Alice paying for /api/expensive-resource (price: 25 LNRD)"

  _ <- pay PayArgs with
    payer = "Alice"
    receiver = "Bob"
    receiverCid
    sessionId = "session-split-test"
    resource = "/api/expensive-resource"
    maxPrice = 25.0
    holdingCid

  debug "Final balances (Alice should have 75, Bob should have 25):"
  balance BalanceArgs with party = "Alice"
  balance BalanceArgs with party = "Bob"

  pure ()
