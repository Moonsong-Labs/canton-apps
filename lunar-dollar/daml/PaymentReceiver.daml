module PaymentReceiver where

import DA.Map qualified as Map (lookup)
import DA.Map (Map)
import DA.Optional (fromSome)

import Daml.Finance.Interface.Types.Common.V3.Types (AccountKey(..), InstrumentKey)

import TransferRequest (TransferRequest(..))

template AccessGrant
  with
    receiver : Party
    payer : Party
    resource : Text
    sessionId : Text
    grantedAt : Time
  where
    signatory receiver, payer

    key (receiver, sessionId) : (Party, Text)
    maintainer key._1

    choice ConsumeAccess : ()
      controller receiver
      do
        pure ()

template PaymentReceiver
  with
    receiver : Party
    receiverAccount : AccountKey
    instrumentKey : InstrumentKey
    prices : Map Text Decimal
    publicParty : Party
  where
    signatory receiver
    observer publicParty

    key receiver : Party
    maintainer key

    nonconsuming choice RequestPayment : (ContractId TransferRequest, Decimal)
      with
        payer : Party
        resource : Text
        maxPrice : Decimal
      controller payer
      do
        let price = fromSome $ Map.lookup resource prices
        assertMsg "Price exceeds maximum agreed amount" (price <= maxPrice)

        transferReqCid <- create TransferRequest with
          receiverAccount
          instrument = instrumentKey
          amount = price
          currentOwner = payer

        pure (transferReqCid, price)

    nonconsuming choice GrantAccess : ContractId AccessGrant
      with
        payer : Party
        sessionId : Text
        resource : Text
      controller payer, receiver
      do
        currentTime <- getTime
        create AccessGrant with
          receiver
          payer
          resource
          sessionId
          grantedAt = currentTime
