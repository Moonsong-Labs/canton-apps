{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx"
  },
  "include": [
    "*.ts",
    "core/**/*.ts",
    "ledger/**/*.ts",
    "utils/**/*.ts",
    "react/**/*.ts",
    "react/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
