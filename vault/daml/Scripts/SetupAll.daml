module Scripts.SetupAll where

import Daml.Script

import Scripts.Setup (setupVault, VaultTestState)
import LunarDollar.Setup (setupLunarDollar)

-- | Combined setup script that initializes both Vault and Lunar Dollar projects.
-- IMPORTANT: Lunar Dollar runs FIRST to create the Bank party and LNRD instrument.
-- Then Vault setup uses LNRD as its deposit currency.
setupAll : Script VaultTestState
setupAll = do
  debug "=========================================="
  debug "Starting combined setup: Lunar Dollar + Vault"
  debug "=========================================="

  -- First, run Lunar Dollar setup (creates Bank party and LNRD instrument)
  debug ""
  debug "[1/2] Running Lunar Dollar setup..."
  setupLunarDollar
  debug "Lunar Dollar setup complete!"
  debug $ "  - Parties: Bank, Alice, Bob, Public"
  debug $ "  - Instrument: LNRD"

  -- Then, run Vault setup (uses LNRD as deposit currency)
  debug ""
  debug "[2/2] Running Vault setup..."
  vaultState <- setupVault
  debug "Vault setup complete!"
  debug $ "  - Parties: Vault (reuses Alice from Lunar Dollar)"
  debug $ "  - Instruments: VAULT-SHARE (uses LNRD for deposits)"

  debug ""
  debug "=========================================="
  debug "Combined setup complete!"
  debug "=========================================="

  pure vaultState

