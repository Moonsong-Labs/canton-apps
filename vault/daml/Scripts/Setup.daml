module Scripts.Setup where

import Daml.Script
import DA.Map qualified as Map (fromList)
import DA.Set qualified as Set (fromList)
import Daml.Finance.Interface.Account.V4.Factory qualified as AccountFactory (I)
import Daml.Finance.Interface.Holding.V4.Holding()
import Daml.Finance.Interface.Instrument.Token.V4.Factory qualified as TokenFactory (Create(..), I)
import Daml.Finance.Interface.Instrument.Token.V4.Types (Token(..))
import Daml.Finance.Interface.Types.Common.V3.Types (AccountKey, HoldingStandard(..), Id(..), InstrumentKey(..))
import Daml.Finance.Account.V4.Account qualified as Account (Factory(..))
import Daml.Finance.Holding.V4.Factory qualified as Holding (Factory(..))
import Daml.Finance.Instrument.Token.V4.Factory qualified as Token (Factory(..))
import Workflow.CreateAccount qualified as CreateAccount (Accept(..), Request(..))
import Workflow.CreditAccount qualified as CreditAccount (Accept(..), Request(..))
import Vault.Config (VaultConfig(..))
import Vault.State (VaultState(..))
import Scripts.Util (createHoldingFactory, getOrCreateParty, getPartyByName)

-- | Initial LNRD funding for the vault treasury (from Bank)
treasuryInitialFunding : Decimal
treasuryInitialFunding = 100000.0  -- 100k LNRD

-- | Setup script: creates parties, factories, instruments, accounts, and vault state.
-- NOTE: This script expects Lunar Dollar setup to have run first (Bank party and LNRD must exist).
-- The Vault uses LNRD (Lunar Dollars) as its deposit currency.
setupVault : Script VaultTestState
setupVault = do
  -- Get/create parties
  [alice, vault, bank] <- mapA getOrCreateParty ["Alice", "Vault", "Bank"]

  -- Create Bank's account factory for Vault's treasury (to hold LNRD)
  -- The treasury needs to be at Bank since LNRD is issued by Bank
  bankAccountFactoryCid <- toInterfaceContractId @AccountFactory.I <$> submit bank do
    createCmd Account.Factory with provider = bank; observers = mempty

  -- Bank's holding factory (for LNRD holdings)
  bankHoldingFactory <- createHoldingFactory
    Holding.Factory with 
      provider = bank
      id = Id "Bank Holding Factory for Vault"
      observers = Map.fromList [("VaultObservers", Set.fromList [vault, alice])]

  -- Create Vault's factories (for VAULT-SHARE holdings)
  vaultAccountFactoryCid <- toInterfaceContractId @AccountFactory.I <$> submit vault do
    createCmd Account.Factory with provider = vault; observers = mempty

  vaultHoldingFactory <- createHoldingFactory
    Holding.Factory with provider = vault; id = Id "Vault Holding Factory"; observers = mempty

  tokenFactoryCid <- toInterfaceContractId @TokenFactory.I <$> submit vault do
    createCmd Token.Factory with provider = vault; observers = mempty

  now <- getTime

  -- Use LNRD as the deposit instrument (issued by Bank from lunar-dollar)
  let depositInstrument = InstrumentKey with
        issuer = bank
        depository = bank
        id = Id "LNRD"
        version = "0"
        holdingStandard = TransferableFungible

  -- Create VAULT-SHARE instrument (issued by Vault)
  let shareInstrument = InstrumentKey with
        issuer = vault; depository = vault; id = Id "VAULT-SHARE"; version = "0"; holdingStandard = TransferableFungible

  submit vault do
    exerciseCmd tokenFactoryCid TokenFactory.Create with
      token = Token with instrument = shareInstrument; description = "Vault Share Token"; validAsOf = now
      observers = mempty

  -- Create Alice's account at Vault (for VAULT-SHARE holdings)
  aliceRequestCid <- submit alice do
    createCmd CreateAccount.Request with owner = alice; custodian = vault

  aliceAccount <- submit vault do
    exerciseCmd aliceRequestCid CreateAccount.Accept with
      label = "Alice@Vault"; description = "Alice's account at Vault"
      accountFactoryCid = vaultAccountFactoryCid; holdingFactory = vaultHoldingFactory; observers = []

  -- Create treasury account at Bank (for LNRD holdings)
  treasuryRequestCid <- submit vault do
    createCmd CreateAccount.Request with owner = vault; custodian = bank

  treasuryAccount <- submit bank do
    exerciseCmd treasuryRequestCid CreateAccount.Accept with
      label = "Treasury@Bank"; description = "Vault Treasury Account (holds LNRD)"
      accountFactoryCid = bankAccountFactoryCid
      holdingFactory = bankHoldingFactory
      observers = [alice]

  -- Fund treasury with initial LNRD from Bank
  treasuryCreditRequestCid <- submit vault do
    createCmd CreditAccount.Request with 
      account = treasuryAccount
      instrument = depositInstrument
      amount = treasuryInitialFunding

  submit bank do
    exerciseCmd treasuryCreditRequestCid CreditAccount.Accept

  -- Create vault config and state
  let vaultId = Id "vault-101"

  vaultConfigCid <- submit vault do
    createCmd VaultConfig with
      operator = vault; custodian = vault; vaultId = vaultId
      name = "LNRD Vault"; description = "A vault for LNRD (Lunar Dollar) deposits"
      depositInstrument; shareInstrument; treasuryAccount
      minDepositAmount = 100.0; baseFee = 0.01; observers = [alice]

  submit vault do
    createCmd VaultState with
      operator = vault; custodian = vault; vaultId = vaultId
      configCid = vaultConfigCid
      totalAssets = treasuryInitialFunding  -- Initial LNRD funding
      totalShares = 0.0; sharePrice = 1.0; observers = [alice]

  -- Return test state
  pure VaultTestState with
    alice; vault; aliceAccount; treasuryAccount
    depositInstrument; shareInstrument; vaultId; vaultConfigCid

-- | Setup script using existing parties (for when parties are already allocated)
-- NOTE: Requires Lunar Dollar setup to have run first.
setupVaultExisting : Script VaultTestState
setupVaultExisting = do
  -- Get existing parties (Alice and Bank from lunar-dollar, Vault may be new)
  alice <- getPartyByName "Alice"
  vault <- getPartyByName "Vault"
  bank <- getPartyByName "Bank"

  -- Create Bank's account factory for Vault's treasury (to hold LNRD)
  bankAccountFactoryCid <- toInterfaceContractId @AccountFactory.I <$> submit bank do
    createCmd Account.Factory with provider = bank; observers = mempty

  bankHoldingFactory <- createHoldingFactory
    Holding.Factory with 
      provider = bank
      id = Id "Bank Holding Factory for Vault"
      observers = Map.fromList [("VaultObservers", Set.fromList [vault, alice])]

  -- Create Vault's factories (for VAULT-SHARE holdings)
  vaultAccountFactoryCid <- toInterfaceContractId @AccountFactory.I <$> submit vault do
    createCmd Account.Factory with provider = vault; observers = mempty

  vaultHoldingFactory <- createHoldingFactory
    Holding.Factory with provider = vault; id = Id "Vault Holding Factory"; observers = mempty

  tokenFactoryCid <- toInterfaceContractId @TokenFactory.I <$> submit vault do
    createCmd Token.Factory with provider = vault; observers = mempty

  now <- getTime

  -- Use LNRD as the deposit instrument (issued by Bank from lunar-dollar)
  let depositInstrument = InstrumentKey with
        issuer = bank
        depository = bank
        id = Id "LNRD"
        version = "0"
        holdingStandard = TransferableFungible

  -- Create VAULT-SHARE instrument (issued by Vault)
  let shareInstrument = InstrumentKey with
        issuer = vault; depository = vault; id = Id "VAULT-SHARE"; version = "0"; holdingStandard = TransferableFungible

  submit vault do
    exerciseCmd tokenFactoryCid TokenFactory.Create with
      token = Token with instrument = shareInstrument; description = "Vault Share Token"; validAsOf = now
      observers = mempty

  -- Create Alice's account at Vault (for VAULT-SHARE holdings)
  aliceRequestCid <- submit alice do
    createCmd CreateAccount.Request with owner = alice; custodian = vault

  aliceAccount <- submit vault do
    exerciseCmd aliceRequestCid CreateAccount.Accept with
      label = "Alice@Vault"; description = "Alice's account at Vault"
      accountFactoryCid = vaultAccountFactoryCid; holdingFactory = vaultHoldingFactory; observers = []

  -- Create treasury account at Bank (for LNRD holdings)
  treasuryRequestCid <- submit vault do
    createCmd CreateAccount.Request with owner = vault; custodian = bank

  treasuryAccount <- submit bank do
    exerciseCmd treasuryRequestCid CreateAccount.Accept with
      label = "Treasury@Bank"; description = "Vault Treasury Account (holds LNRD)"
      accountFactoryCid = bankAccountFactoryCid
      holdingFactory = bankHoldingFactory
      observers = [alice]

  -- Fund treasury with initial LNRD from Bank
  treasuryCreditRequestCid <- submit vault do
    createCmd CreditAccount.Request with 
      account = treasuryAccount
      instrument = depositInstrument
      amount = treasuryInitialFunding

  submit bank do
    exerciseCmd treasuryCreditRequestCid CreditAccount.Accept

  -- Create vault config and state
  let vaultId = Id "vault-101"

  vaultConfigCid <- submit vault do
    createCmd VaultConfig with
      operator = vault; custodian = vault; vaultId = vaultId
      name = "LNRD Vault"; description = "A vault for LNRD (Lunar Dollar) deposits"
      depositInstrument; shareInstrument; treasuryAccount
      minDepositAmount = 100.0; baseFee = 0.01; observers = [alice]

  submit vault do
    createCmd VaultState with
      operator = vault; custodian = vault; vaultId = vaultId
      configCid = vaultConfigCid
      totalAssets = treasuryInitialFunding
      totalShares = 0.0; sharePrice = 1.0; observers = [alice]

  pure VaultTestState with
    alice; vault; aliceAccount; treasuryAccount
    depositInstrument; shareInstrument; vaultId; vaultConfigCid

-- | Test state returned by setup scripts
data VaultTestState = VaultTestState
  with
    alice : Party
    vault : Party
    aliceAccount : AccountKey
    treasuryAccount : AccountKey
    depositInstrument : InstrumentKey  -- LNRD (from Bank)
    shareInstrument : InstrumentKey    -- VAULT-SHARE (from Vault)
    vaultId : Id
    vaultConfigCid : ContractId VaultConfig
